{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bonk Box",
  "version": "0.2.3",
  "identifier": "to.granular.bonkbox",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bonk Box",
        "width": 560,
        "height": 460,
        "minWidth": 420,
        "minHeight": 340,
        "resizable": true,
        "alwaysOnTop": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
